# Configuration dYdX Executor
# Copier ce fichier vers .env et remplir les valeurs

# Port du serveur (défaut: 3001)
PORT=3001

# dYdX Testnet Configuration
DYDX_TESTNET_MNEMONIC=your_mnemonic_here
DYDX_TESTNET_ADDRESS=dydx1xxx...

# dYdX Mainnet Configuration (quand prêt pour production)
# DYDX_MAINNET_MNEMONIC=your_mainnet_mnemonic
# DYDX_MAINNET_ADDRESS=dydx1xxx...

# Sécurité API (optionnel mais recommandé en production)
API_SECRET_KEY=your_secret_key_here

# Réseau (testnet ou mainnet)
DYDX_NETWORK=testnet
