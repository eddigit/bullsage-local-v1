# Exemple de variables d'environnement pour le backend
# Copiez ce fichier en .env et modifiez les valeurs

# ========== MongoDB ==========
# Pour le développement local, utilisez MongoDB local ou MongoDB Atlas (gratuit)
# MongoDB Atlas : https://www.mongodb.com/atlas
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=bullsage

# ========== Authentification ==========
# Générez une clé secrète aléatoire pour la production
# Vous pouvez utiliser : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=votre_secret_jwt_securise_genere_aleatoirement

# ========== LLM / IA ==========
# Provider principal: xAI (Grok)
XAI_API_KEY=votre_cle_xai

# Providers alternatifs (optionnel)
ANTHROPIC_API_KEY=votre_cle_anthropic
OPENROUTER_API_KEY=votre_cle_openrouter
GROQ_API_KEY=votre_cle_groq

# Provider actif: xai, anthropic, ou openrouter
LLM_PROVIDER=xai

# ========== APIs Crypto ==========
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# ========== APIs Financières (optionnel) ==========
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
MARKETAUX_API_KEY=

# ========== CORS (pour le déploiement) ==========
# Liste des origines autorisées, séparées par des virgules
# Laissez * pour autoriser toutes les origines (moins sécurisé)
CORS_ORIGINS=*
# Exemple pour production : CORS_ORIGINS=https://bullsage-frontend.onrender.com,https://bullsage.com

# ========== dYdX Configuration ==========
DYDX_TESTNET_MNEMONIC=votre_mnemonic_24_mots
DYDX_TESTNET_ADDRESS=dydx1xxx...
DYDX_EXECUTOR_URL=http://localhost:3001
DYDX_API_SECRET=

# ========== Webhook Automatisation ==========
# Token pour authentifier les appels webhook (Claude, bots, etc.)
# Générez avec: python -c "import secrets; print(secrets.token_hex(32))"
CLAUDE_WEBHOOK_TOKEN=votre_token_webhook_securise

# ========== Trading Configuration ==========
# Ces valeurs peuvent être overridées par les variables d'environnement
MAX_RISK_PERCENT=2.0
MAX_LEVERAGE=10
MIN_CONFIDENCE=80
TRADE_COOLDOWN_SECONDS=60
MAX_SLIPPAGE_PERCENT=1.0
ALLOWED_MARKETS=BTC-USD,ETH-USD,SOL-USD,AVAX-USD,DOGE-USD,XRP-USD,ADA-USD
TRADING_ENABLED=true
